@page "/dashboard"
@attribute [Authorize]
@inject IAccessTokenProvider _accessTokenProvider
@inject HttpClient _httpClient

<h1>@_welcomeMsg</h1>

@code  {
	[CascadingParameter]
	private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

	private string _welcomeMsg = "Welcome to dashboard!";

	protected override async Task OnInitializedAsync()
	{
		await GetWelcomeMsg();
	}

	private async Task GetWelcomeMsg()
	{
		var authState = await AuthenticationState;
		var accessTokenResult = await _accessTokenProvider.RequestAccessToken();

		accessTokenResult.TryGetToken(out var accessToken);

		 _httpClient.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", accessToken?.Value);

         try
         {
             var response = await _httpClient.GetAsync("api/messages/getWelcomeMsg");
             _welcomeMsg = await response.Content.ReadAsStringAsync();
         }
         catch (AccessTokenNotAvailableException ex)
         {
             ex.Redirect();
         }
	}
}